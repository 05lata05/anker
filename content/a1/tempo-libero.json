  "lessons": [
    {
      "id": "l-am-wochenende",
      "cefr": "A1",
      "topic": "tempo_libero",
      "audioPath": null,
      "targetItemIds": ["am-wochenende", "ich-spiele-gern-fussball", "hast-du-lust", "ich-gehe-ins-kino", "gute-idee"],
      "lines": [
        { "speaker": "Jonas", "de": "Was machst du am Wochenende?", "it": "Cosa fai nel fine settimana?" },
        { "speaker": "Mia", "de": "Am Wochenende spiele ich gern Fußball.", "it": "Nel fine settimana mi piace giocare a calcio." },
        { "speaker": "Jonas", "de": "Und am Abend? Hast du Lust?", "it": "E la sera? Ti va?" },
        { "speaker": "Mia", "de": "Wofür?", "it": "Per cosa?" },
        { "speaker": "Jonas", "de": "Wir gehen ins Kino. Es gibt einen neuen Film.", "it": "Andiamo al cinema. C'è un film nuovo." },
        { "speaker": "Mia", "de": "Gute Idee!", "it": "Buona idea!" }
      ],
      "questions": [
        { "de": "Was macht Mia am Wochenende?", "options": ["Sie spielt Fußball", "Sie liest", "Sie arbeitet"], "answerIndex": 0 },
        { "de": "Wohin gehen sie am Abend?", "options": ["Ins Restaurant", "Ins Kino", "Nach Hause"], "answerIndex": 1 }
      ]
    },
    {
      "id": "l-schlechtes-wetter",
      "cefr": "A1",
      "topic": "tempo_libero",
      "audioPath": null,
      "targetItemIds": ["das-wetter-ist-schoen", "es-regnet", "ich-bleibe-zu-hause-weil-ich-krank-bin", "das-buch-lesen", "wenn-ich-zeit-habe"],
      "lines": [
        { "speaker": "Ana", "de": "Wie ist das Wetter heute?", "it": "Com'è il tempo oggi?" },
        { "speaker": "Leo", "de": "Nicht gut. Es regnet.", "it": "Non buono. Piove." },
        { "speaker": "Ana", "de": "Gehen wir trotzdem spazieren?", "it": "Andiamo a passeggiare lo stesso?" },
        { "speaker": "Leo", "de": "Nein, ich bleibe zu Hause, weil ich krank bin.", "it": "No, resto a casa perché sono malato." },
        { "speaker": "Ana", "de": "Was machst du dann?", "it": "Cosa fai allora?" },
        { "speaker": "Leo", "de": "Wenn ich Zeit habe, lese ich ein Buch.", "it": "Quando ho tempo, leggo un libro." }
      ],
      "questions": [
        { "de": "Wie ist das Wetter?", "options": ["Schön", "Es regnet", "Es schneit"], "answerIndex": 1 },
        { "de": "Warum bleibt Leo zu Hause?", "options": ["Er ist krank", "Er arbeitet", "Er hat keine Lust"], "answerIndex": 0 }
      ]
    }
  ]
