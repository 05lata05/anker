  "lessons": [
    {
      "id": "l-die-neue-wohnung",
      "cefr": "A1",
      "topic": "casa",
      "audioPath": null,
      "targetItemIds": ["ich-suche-eine-wohnung", "wie-viele-zimmer-hat-die-wohnung", "die-wohnung-ist-hell", "die-miete", "die-wohnung-ist-zu-teuer"],
      "lines": [
        { "speaker": "Makler", "de": "Guten Tag, was suchen Sie?", "it": "Buongiorno, cosa cerca?" },
        { "speaker": "Eva", "de": "Ich suche eine Wohnung.", "it": "Cerco un appartamento." },
        { "speaker": "Makler", "de": "Hier ist eine. Die Wohnung ist hell.", "it": "Eccone uno. L'appartamento è luminoso." },
        { "speaker": "Eva", "de": "Wie viele Zimmer hat die Wohnung?", "it": "Quante stanze ha l'appartamento?" },
        { "speaker": "Makler", "de": "Drei Zimmer, Küche und Bad. Die Miete ist neunhundert Euro.", "it": "Tre stanze, cucina e bagno. L'affitto è novecento euro." },
        { "speaker": "Eva", "de": "Oh, das ist zu teuer.", "it": "Oh, è troppo caro." }
      ],
      "questions": [
        { "de": "Was sucht Eva?", "options": ["Eine Wohnung", "Ein Haus", "Ein Zimmer"], "answerIndex": 0 },
        { "de": "Warum sagt Eva nein?", "options": ["Die Wohnung ist dunkel", "Die Miete ist zu hoch", "Es gibt kein Bad"], "answerIndex": 1 }
      ]
    },
    {
      "id": "l-wo-ist-der-schluessel",
      "cefr": "A1",
      "topic": "casa",
      "audioPath": null,
      "targetItemIds": ["der-schluessel", "das-buch-liegt-auf-dem-tisch", "ich-bin-in-der-kueche", "ich-gehe-in-die-kueche", "das-zimmer"],
      "lines": [
        { "speaker": "Max", "de": "Wo bist du?", "it": "Dove sei?" },
        { "speaker": "Lea", "de": "Ich bin in der Küche.", "it": "Sono in cucina." },
        { "speaker": "Max", "de": "Wo ist mein Schlüssel?", "it": "Dov'è la mia chiave?" },
        { "speaker": "Lea", "de": "Im Wohnzimmer. Er liegt auf dem Tisch.", "it": "In soggiorno. È sul tavolo." },
        { "speaker": "Max", "de": "Und mein Buch?", "it": "E il mio libro?" },
        { "speaker": "Lea", "de": "Das Buch liegt auch auf dem Tisch.", "it": "Anche il libro è sul tavolo." }
      ],
      "questions": [
        { "de": "Wo ist Lea?", "options": ["Im Bad", "In der Küche", "Im Garten"], "answerIndex": 1 },
        { "de": "Wo liegt der Schlüssel?", "options": ["Auf dem Tisch", "Im Schrank", "Auf dem Bett"], "answerIndex": 0 }
      ]
    }
  ]
