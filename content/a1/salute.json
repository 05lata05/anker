  "lessons": [
    {
      "id": "l-beim-arzt",
      "cefr": "A1",
      "topic": "salute",
      "audioPath": null,
      "targetItemIds": ["ich-habe-kopfschmerzen", "mir-ist-schlecht", "gute-besserung", "der-arzt", "das-wasser"],
      "lines": [
        { "speaker": "Arzt", "de": "Guten Tag! Was haben Sie?", "it": "Buongiorno! Cosa si sente?" },
        { "speaker": "Patient", "de": "Ich habe Kopfschmerzen. Und mir ist schlecht.", "it": "Ho mal di testa. E ho la nausea." },
        { "speaker": "Arzt", "de": "Seit wann?", "it": "Da quando?" },
        { "speaker": "Patient", "de": "Seit gestern.", "it": "Da ieri." },
        { "speaker": "Arzt", "de": "Sie bleiben zu Hause und trinken viel Wasser.", "it": "Resti a casa e beva molta acqua." },
        { "speaker": "Patient", "de": "Gut, danke.", "it": "Bene, grazie." },
        { "speaker": "Arzt", "de": "Gute Besserung!", "it": "Guarisca presto!" }
      ],
      "questions": [
        { "de": "Was hat der Patient?", "options": ["Kopfschmerzen", "Zahnschmerzen", "Rückenschmerzen"], "answerIndex": 0 },
        { "de": "Was soll der Patient trinken?", "options": ["Kaffee", "Wasser", "Suppe"], "answerIndex": 1 }
      ]
    },
    {
      "id": "l-in-der-apotheke",
      "cefr": "A1",
      "topic": "salute",
      "audioPath": null,
      "targetItemIds": ["die-apotheke", "das-medikament", "ich-habe-mich-erkaeltet", "sie-muessen-viel-trinken", "ich-nehme-eine-tablette"],
      "lines": [
        { "speaker": "Apothekerin", "de": "Guten Tag, was brauchen Sie?", "it": "Buongiorno, di cosa ha bisogno?" },
        { "speaker": "Kunde", "de": "Ich habe mich erkältet.", "it": "Mi sono raffreddato." },
        { "speaker": "Apothekerin", "de": "Haben Sie Fieber?", "it": "Ha la febbre?" },
        { "speaker": "Kunde", "de": "Nein, aber ich bin sehr müde.", "it": "No, ma sono molto stanco." },
        { "speaker": "Apothekerin", "de": "Hier ist ein Medikament. Sie müssen viel trinken.", "it": "Ecco un medicinale. Deve bere molto." },
        { "speaker": "Kunde", "de": "Danke. Ich nehme eine Tablette am Morgen.", "it": "Grazie. Prendo una pastiglia la mattina." }
      ],
      "questions": [
        { "de": "Was hat der Kunde?", "options": ["Er hat sich erkältet", "Er hat Fieber", "Er hat Kopfschmerzen"], "answerIndex": 0 },
        { "de": "Was soll der Kunde tun?", "options": ["Viel schlafen", "Viel trinken", "Zum Arzt gehen"], "answerIndex": 1 }
      ]
    }
  ]
