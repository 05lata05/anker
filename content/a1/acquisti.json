  "lessons": [
    {
      "id": "l-im-supermarkt",
      "cefr": "A1",
      "topic": "acquisti",
      "audioPath": null,
      "targetItemIds": ["es-gibt-einen-supermarkt", "wo-finde-ich-das-brot", "was-kostet-das", "ich-zahle-mit-karte", "der-euro"],
      "lines": [
        { "speaker": "Kunde", "de": "Entschuldigung, wo finde ich das Brot?", "it": "Scusi, dove trovo il pane?" },
        { "speaker": "Verkäufer", "de": "Dort hinten, links.", "it": "Là in fondo, a sinistra." },
        { "speaker": "Kunde", "de": "Danke. Und was kostet das?", "it": "Grazie. E quanto costa?" },
        { "speaker": "Verkäufer", "de": "Zwei Euro fünfzig.", "it": "Due euro e cinquanta." },
        { "speaker": "Kunde", "de": "Gut, ich nehme es. Ich zahle mit Karte.", "it": "Bene, lo prendo. Pago con la carta." },
        { "speaker": "Verkäufer", "de": "Kein Problem.", "it": "Nessun problema." }
      ],
      "questions": [
        { "de": "Was sucht der Kunde?", "options": ["Das Brot", "Den Käse", "Die Milch"], "answerIndex": 0 },
        { "de": "Wie zahlt der Kunde?", "options": ["Bar", "Mit Karte", "Er zahlt nicht"], "answerIndex": 1 }
      ]
    },
    {
      "id": "l-im-geschaeft",
      "cefr": "A1",
      "topic": "acquisti",
      "audioPath": null,
      "targetItemIds": ["haben-sie-das-in-groesse-vierzig", "kann-ich-das-anprobieren", "das-ist-zu-teuer", "ich-suche-ein-geschenk", "die-hose"],
      "lines": [
        { "speaker": "Verkäuferin", "de": "Kann ich Ihnen helfen?", "it": "Posso aiutarla?" },
        { "speaker": "Nils", "de": "Ja, ich suche ein Geschenk. Diese Hose ist schön.", "it": "Sì, cerco un regalo. Questi pantaloni sono belli." },
        { "speaker": "Verkäuferin", "de": "Welche Größe?", "it": "Quale taglia?" },
        { "speaker": "Nils", "de": "Haben Sie das in Größe vierzig? Kann ich das anprobieren?", "it": "Ce l'ha nella taglia quaranta? Posso provarli?" },
        { "speaker": "Verkäuferin", "de": "Natürlich. Sie kostet neunzig Euro.", "it": "Certo. Costano novanta euro." },
        { "speaker": "Nils", "de": "Oh, das ist zu teuer.", "it": "Oh, è troppo caro." }
      ],
      "questions": [
        { "de": "Was sucht Nils?", "options": ["Ein Geschenk", "Ein Buch", "Essen"], "answerIndex": 0 },
        { "de": "Warum kauft Nils die Hose nicht?", "options": ["Falsche Größe", "Zu teuer", "Sie gefällt ihm nicht"], "answerIndex": 1 }
      ]
    }
  ]
