      "lines": [
        { "speaker": "Kellner", "de": "Guten Tag! Was möchten Sie?", "it": "Buongiorno! Cosa desidera?" },
        { "speaker": "Gast", "de": "Ich hätte gern einen Kaffee, bitte.", "it": "Vorrei un caffè, per favore." },
        { "speaker": "Kellner", "de": "Gern. Möchten Sie auch Wasser?", "it": "Volentieri. Desidera anche dell'acqua?" },
        { "speaker": "Gast", "de": "Ja, bitte. Was kostet der Kaffee?", "it": "Sì, grazie. Quanto costa il caffè?" },
        { "speaker": "Kellner", "de": "Drei Euro.", "it": "Tre euro." },
        { "speaker": "Gast", "de": "Gut. Die Rechnung, bitte.", "it": "Bene. Il conto, per favore." }
      ],
      "questions": [
        { "de": "Was bestellt der Gast?", "options": ["Einen Kaffee", "Eine Suppe", "Ein Brot"], "answerIndex": 0 },
        { "de": "Wie viel kostet der Kaffee?", "options": ["Zwei Euro", "Drei Euro", "Acht Euro"], "answerIndex": 1 }
      ]
    },
    {
      "id": "l-im-restaurant",
      "cefr": "A1",
      "topic": "ristorante",
      "audioPath": null,
      "targetItemIds": ["einen-tisch-fuer-zwei", "was-moechten-sie-trinken", "ich-nehme-die-suppe", "guten-appetit", "zahlen-bitte"],
      "lines": [
        { "speaker": "Gast", "de": "Guten Abend. Einen Tisch für zwei, bitte.", "it": "Buonasera. Un tavolo per due, per favore." },
        { "speaker": "Kellner", "de": "Gern, hier ist die Speisekarte.", "it": "Volentieri, ecco il menù." },
        { "speaker": "Kellner", "de": "Was möchten Sie trinken?", "it": "Cosa desidera bere?" },
        { "speaker": "Gast", "de": "Ein Glas Wasser, bitte. Und ich nehme die Suppe.", "it": "Un bicchiere d'acqua, per favore. E prendo la zuppa." },
        { "speaker": "Kellner", "de": "Guten Appetit!", "it": "Buon appetito!" },
        { "speaker": "Gast", "de": "Danke. Später zahlen, bitte!", "it": "Grazie. Dopo il conto, per favore!" }
      ],
      "questions": [
        { "de": "Für wie viele Personen ist der Tisch?", "options": ["Für eine", "Für zwei", "Für vier"], "answerIndex": 1 },
