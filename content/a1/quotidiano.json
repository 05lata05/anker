    {
      "id": "l-im-unterricht",
      "cefr": "A1",
      "topic": "quotidiano",
      "audioPath": null,
      "targetItemIds": ["ich-habe-eine-frage", "was-bedeutet-das", "auf-deutsch", "sprechen-sie-langsamer", "wie-schreibt-man-das"],
      "lines": [
        { "speaker": "Schüler", "de": "Entschuldigung, ich habe eine Frage.", "it": "Scusi, ho una domanda." },
        { "speaker": "Lehrer", "de": "Ja, bitte.", "it": "Sì, prego." },
        { "speaker": "Schüler", "de": "Was bedeutet das Wort hier?", "it": "Cosa significa questa parola qui?" },
        { "speaker": "Lehrer", "de": "Das heißt «Verspätung».", "it": "Vuol dire «ritardo»." },
        { "speaker": "Schüler", "de": "Wie schreibt man das? Sprechen Sie bitte langsamer.", "it": "Come si scrive? Parli più lentamente, per favore." },
        { "speaker": "Lehrer", "de": "V–E–R–S–P–Ä–T–U–N–G.", "it": "V–E–R–S–P–Ä–T–U–N–G." }
      ],
      "questions": [
        { "de": "Was fragt der Schüler zuerst?", "options": ["Was ein Wort bedeutet", "Wie spät es ist", "Wo die Toilette ist"], "answerIndex": 0 },
        { "de": "Welches Wort erklärt der Lehrer?", "options": ["Verspätung", "Wohnung", "Rechnung"], "answerIndex": 0 }
      ]
    },
    {
      "id": "l-kleine-hilfe",
      "cefr": "A1",
      "topic": "quotidiano",
      "audioPath": null,
      "targetItemIds": ["koennen-sie-mir-helfen", "wo-ist-die-toilette", "einen-moment-bitte", "natuerlich", "alles-klar"],
      "lines": [
        { "speaker": "Gast", "de": "Entschuldigung, können Sie mir helfen?", "it": "Scusi, può aiutarmi?" },
        { "speaker": "Angestellter", "de": "Natürlich. Was brauchen Sie?", "it": "Certo. Di cosa ha bisogno?" },
        { "speaker": "Gast", "de": "Wo ist die Toilette?", "it": "Dov'è il bagno?" },
        { "speaker": "Angestellter", "de": "Einen Moment, bitte. Ich zeige es Ihnen.", "it": "Un momento, per favore. Glielo mostro." },
        { "speaker": "Angestellter", "de": "Dort hinten rechts, neben dem Ausgang.", "it": "Là in fondo a destra, accanto all'uscita." },
        { "speaker": "Gast", "de": "Alles klar, vielen Dank!", "it": "Tutto chiaro, grazie mille!" }
      ],
      "questions": [
        { "de": "Was sucht der Gast?", "options": ["Die Toilette", "Den Ausgang", "Das Restaurant"], "answerIndex": 0 },
        { "de": "Wo ist sie?", "options": ["Dort hinten rechts", "Dort vorne links", "Im ersten Stock"], "answerIndex": 0 }
      ]
    }
