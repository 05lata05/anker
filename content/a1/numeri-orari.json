    {
      "id": "l-wie-spaet",
      "cefr": "A1",
      "topic": "orari",
      "audioPath": null,
      "targetItemIds": ["wie-spaet-ist-es", "es-ist-halb-drei", "um-acht-uhr", "wann-faengt-es-an", "die-zeit"],
      "lines": [
        { "speaker": "Jonas", "de": "Entschuldigung, wie spät ist es?", "it": "Scusa, che ore sono?" },
        { "speaker": "Mia", "de": "Es ist halb drei.", "it": "Sono le due e mezza." },
        { "speaker": "Jonas", "de": "Schon? Und wann fängt der Film an?", "it": "Già? E quando comincia il film?" },
        { "speaker": "Mia", "de": "Um drei Uhr.", "it": "Alle tre." },
        { "speaker": "Jonas", "de": "Dann haben wir noch Zeit.", "it": "Allora abbiamo ancora tempo." },
        { "speaker": "Mia", "de": "Nur eine halbe Stunde!", "it": "Solo mezz'ora!" }
      ],
      "questions": [
        { "de": "Wie spät ist es?", "options": ["Halb zwei", "Halb drei", "Drei Uhr"], "answerIndex": 1 },
        { "de": "Wann fängt der Film an?", "options": ["Um zwei Uhr", "Um halb drei", "Um drei Uhr"], "answerIndex": 2 }
      ]
    },
    {
      "id": "l-die-woche",
      "cefr": "A1",
      "topic": "orari",
      "audioPath": null,
      "targetItemIds": ["heute", "der-montag", "der-freitag", "jeden-tag", "die-woche"],
      "lines": [
        { "speaker": "Sara", "de": "Welcher Tag ist heute?", "it": "Che giorno è oggi?" },
        { "speaker": "Ben", "de": "Heute ist Montag.", "it": "Oggi è lunedì." },
        { "speaker": "Sara", "de": "Arbeitest du jeden Tag?", "it": "Lavori tutti i giorni?" },
        { "speaker": "Ben", "de": "Nein, von Montag bis Freitag.", "it": "No, dal lunedì al venerdì." },
        { "speaker": "Sara", "de": "Und am Wochenende?", "it": "E nel fine settimana?" },
        { "speaker": "Ben", "de": "Am Wochenende habe ich frei.", "it": "Nel fine settimana sono libero." }
      ],
      "questions": [
        { "de": "Welcher Tag ist heute?", "options": ["Montag", "Freitag", "Sonntag"], "answerIndex": 0 },
        { "de": "Wann arbeitet Ben nicht?", "options": ["Am Montag", "Am Wochenende", "Jeden Tag"], "answerIndex": 1 }
      ]
    }
  ]
