      "id": "l-sich-vorstellen",
      "cefr": "A1",
      "topic": "presentarsi",
      "audioPath": null,
      "targetItemIds": ["ich-heisse", "wie-heissen-sie", "ich-komme-aus-italien", "ich-wohne-in-berlin", "freut-mich", "guten-tag"],
      "lines": [
        { "speaker": "Anna", "de": "Guten Tag! Wie heißen Sie?", "it": "Buongiorno! Come si chiama?" },
        { "speaker": "Luigi", "de": "Ich heiße Luigi. Und Sie?", "it": "Mi chiamo Luigi. E Lei?" },
        { "speaker": "Anna", "de": "Ich heiße Anna. Freut mich!", "it": "Mi chiamo Anna. Piacere!" },
        { "speaker": "Luigi", "de": "Freut mich auch. Ich komme aus Italien.", "it": "Piacere mio. Vengo dall'Italia." },
        { "speaker": "Anna", "de": "Und wo wohnen Sie jetzt?", "it": "E dove abita adesso?" },
        { "speaker": "Luigi", "de": "Ich wohne in Berlin.", "it": "Abito a Berlino." }
      ],
      "questions": [
        { "de": "Woher kommt Luigi?", "options": ["Aus Italien", "Aus Berlin", "Aus Österreich"], "answerIndex": 0 },
        { "de": "Wo wohnt Luigi?", "options": ["In Rom", "In Berlin", "In Wien"], "answerIndex": 1 }
      ]
    },
    {
      "id": "l-im-sprachkurs",
      "cefr": "A1",
      "topic": "presentarsi",
      "audioPath": null,
      "targetItemIds": ["ich-lerne-deutsch", "ich-verstehe-nicht", "koennen-sie-das-wiederholen", "ich-spreche-ein-bisschen-deutsch", "ich-bin-zwanzig-jahre-alt"],
      "lines": [
        { "speaker": "Lehrerin", "de": "Warum lernen Sie Deutsch?", "it": "Perché studia tedesco?" },
        { "speaker": "Luigi", "de": "Entschuldigung, ich verstehe nicht.", "it": "Scusi, non capisco." },
        { "speaker": "Lehrerin", "de": "Warum lernen Sie Deutsch?", "it": "Perché studia tedesco?" },
        { "speaker": "Luigi", "de": "Können Sie das wiederholen? Langsam, bitte.", "it": "Può ripeterlo? Lentamente, per favore." },
        { "speaker": "Lehrerin", "de": "Warum … lernen … Sie … Deutsch?", "it": "Perché … studia … tedesco?" },
        { "speaker": "Luigi", "de": "Ah! Ich arbeite in Berlin. Ich spreche ein bisschen Deutsch.", "it": "Ah! Lavoro a Berlino. Parlo un po' di tedesco." }
      ],
      "questions": [
        { "de": "Was versteht Luigi zuerst nicht?", "options": ["Die Frage", "Den Namen", "Die Uhrzeit"], "answerIndex": 0 },
        { "de": "Warum lernt Luigi Deutsch?", "options": ["Er arbeitet in Berlin", "Er ist Lehrer", "Er ist Student"], "answerIndex": 0 }
      ]
    }
