  "lessons": [
    {
      "id": "l-meine-familie",
      "cefr": "A1",
      "topic": "famiglia",
      "audioPath": null,
      "targetItemIds": ["die-familie", "meine-mutter-heisst-anna", "ich-habe-einen-bruder", "die-schwester", "das-kind", "hast-du-geschwister"],
      "lines": [
        { "speaker": "Tim", "de": "Ist das deine Familie?", "it": "È la tua famiglia?" },
        { "speaker": "Sara", "de": "Ja. Das ist meine Mutter. Meine Mutter heißt Anna.", "it": "Sì. Questa è mia madre. Mia madre si chiama Anna." },
        { "speaker": "Tim", "de": "Und hast du Geschwister?", "it": "E hai fratelli?" },
        { "speaker": "Sara", "de": "Ich habe einen Bruder und eine Schwester.", "it": "Ho un fratello e una sorella." },
        { "speaker": "Tim", "de": "Wie alt ist dein Bruder?", "it": "Quanti anni ha tuo fratello?" },
        { "speaker": "Sara", "de": "Er ist zehn. Er ist noch ein Kind.", "it": "Ha dieci anni. È ancora un bambino." }
      ],
      "questions": [
        { "de": "Wie heißt die Mutter von Sara?", "options": ["Anna", "Sara", "Tim"], "answerIndex": 0 },
        { "de": "Wie viele Geschwister hat Sara?", "options": ["Eins", "Zwei", "Drei"], "answerIndex": 1 }
      ]
    },
    {
      "id": "l-zu-hause-bei-den-eltern",
      "cefr": "A1",
      "topic": "famiglia",
      "audioPath": null,
      "targetItemIds": ["ich-wohne-bei-meinen-eltern", "meine-schwester-arbeitet-in-muenchen", "der-hund", "wir-sind-zu-viert", "die-eltern"],
      "lines": [
        { "speaker": "Nina", "de": "Wohnst du allein?", "it": "Abiti da solo?" },
        { "speaker": "Paul", "de": "Nein, ich wohne bei meinen Eltern.", "it": "No, abito dai miei genitori." },
        { "speaker": "Nina", "de": "Und deine Schwester?", "it": "E tua sorella?" },
        { "speaker": "Paul", "de": "Meine Schwester arbeitet in München.", "it": "Mia sorella lavora a Monaco." },
        { "speaker": "Nina", "de": "Seid ihr also zu dritt zu Hause?", "it": "Siete quindi in tre a casa?" },
        { "speaker": "Paul", "de": "Mit dem Hund sind wir zu viert!", "it": "Col cane siamo in quattro!" }
      ],
      "questions": [
        { "de": "Wo wohnt Paul?", "options": ["Allein", "Bei seinen Eltern", "In München"], "answerIndex": 1 },
        { "de": "Wer wohnt in München?", "options": ["Paul", "Seine Schwester", "Der Hund"], "answerIndex": 1 }
      ]
    }
  ]
