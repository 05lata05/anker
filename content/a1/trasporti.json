        { "speaker": "Frau", "de": "Um acht Uhr.", "it": "Alle otto." }
      ],
      "questions": [
        { "de": "Wohin möchte der Tourist?", "options": ["Zum Bahnhof", "Ins Café", "Nach Hause"], "answerIndex": 0 },
        { "de": "Wann fährt der Zug?", "options": ["Um sechs Uhr", "Um acht Uhr", "Um neun Uhr"], "answerIndex": 1 }
      ]
    },
