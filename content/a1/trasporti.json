        { "speaker": "Reisender", "de": "Gut. Fährt der Zug pünktlich?", "it": "Bene. Il treno è puntuale?" },
        { "speaker": "Beamter", "de": "Nein, der Zug hat zehn Minuten Verspätung.", "it": "No, il treno ha dieci minuti di ritardo." }
      ],
      "questions": [
        { "de": "Wo muss der Reisende umsteigen?", "options": ["In Berlin", "In Köln", "In München"], "answerIndex": 1 },
