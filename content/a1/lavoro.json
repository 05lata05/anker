        { "speaker": "Nora", "de": "Was machst du gerade?", "it": "Cosa stai facendo?" },
        { "speaker": "Tim", "de": "Ich schreibe eine E-Mail an einen Kollegen.", "it": "Scrivo un'email a un collega." },
        { "speaker": "Nora", "de": "Wann ist die Besprechung?", "it": "Quando è la riunione?" },
        { "speaker": "Tim", "de": "Um zehn. Ich muss aber schon um neun anfangen.", "it": "Alle dieci. Ma devo iniziare già alle nove." },
        { "speaker": "Nora", "de": "Gut, ich rufe dich später an.", "it": "Bene, ti chiamo più tardi." },
        { "speaker": "Tim", "de": "Danke, bis später!", "it": "Grazie, a dopo!" }
      ],
      "questions": [
