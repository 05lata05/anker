        { "speaker": "Klara", "de": "Was sind Sie von Beruf?", "it": "Che lavoro fa?" },
        { "speaker": "Ali", "de": "Ich arbeite als Lehrer.", "it": "Lavoro come insegnante." },
        { "speaker": "Klara", "de": "Und wo?", "it": "E dove?" },
        { "speaker": "Ali", "de": "In einer Schule in Hamburg. Sie arbeiten im Büro, oder?", "it": "In una scuola ad Amburgo. Lei lavora in ufficio, vero?" },
        { "speaker": "Klara", "de": "Ja, ich arbeite von neun bis fünf.", "it": "Sì, lavoro dalle nove alle cinque." },
        { "speaker": "Ali", "de": "Und macht die Arbeit Spaß?", "it": "E il lavoro le piace?" }
      ],
      "questions": [
        { "de": "Was ist Ali von Beruf?", "options": ["Lehrer", "Student", "Arzt"], "answerIndex": 0 },
        { "de": "Wann arbeitet Klara?", "options": ["Von acht bis vier", "Von neun bis fünf", "Am Wochenende"], "answerIndex": 1 }
      ]
    },
    {
