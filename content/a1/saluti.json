    {
      "id": "l-auf-der-strasse",
      "cefr": "A1",
      "topic": "saluti",
      "audioPath": null,
      "targetItemIds": ["guten-tag", "wie-geht-es-ihnen", "mir-geht-es-gut", "auf-wiedersehen", "bis-morgen"],
      "lines": [
        { "speaker": "Frau Weber", "de": "Guten Tag, Herr Klein!", "it": "Buongiorno, signor Klein!" },
        { "speaker": "Herr Klein", "de": "Guten Tag! Wie geht es Ihnen?", "it": "Buongiorno! Come sta?" },
        { "speaker": "Frau Weber", "de": "Mir geht es gut, danke. Und Ihnen?", "it": "Sto bene, grazie. E Lei?" },
        { "speaker": "Herr Klein", "de": "Auch gut, danke.", "it": "Anche io bene, grazie." },
        { "speaker": "Frau Weber", "de": "Also, bis morgen!", "it": "Allora, a domani!" },
        { "speaker": "Herr Klein", "de": "Auf Wiedersehen!", "it": "Arrivederci!" }
      ],
      "questions": [
        { "de": "Wie geht es Frau Weber?", "options": ["Gut", "Schlecht", "Nicht so gut"], "answerIndex": 0 },
        { "de": "Wann sehen sie sich wieder?", "options": ["Heute Abend", "Morgen", "Nächste Woche"], "answerIndex": 1 }
      ]
    },
    {
      "id": "l-danke-und-bitte",
      "cefr": "A1",
      "topic": "saluti",
      "audioPath": null,
      "targetItemIds": ["entschuldigung", "vielen-dank", "bitte-schoen", "kein-problem", "es-tut-mir-leid"],
      "lines": [
        { "speaker": "Tom", "de": "Entschuldigung, ist der Platz frei?", "it": "Scusi, il posto è libero?" },
        { "speaker": "Lena", "de": "Ja, bitte schön.", "it": "Sì, prego." },
        { "speaker": "Tom", "de": "Vielen Dank!", "it": "Grazie mille!" },
        { "speaker": "Lena", "de": "Gern geschehen.", "it": "Di niente." },
        { "speaker": "Tom", "de": "Oh, es tut mir leid!", "it": "Oh, mi dispiace!" },
        { "speaker": "Lena", "de": "Kein Problem.", "it": "Nessun problema." }
      ],
      "questions": [
        { "de": "Was fragt Tom?", "options": ["Ob der Platz frei ist", "Wie spät es ist", "Wo der Bahnhof ist"], "answerIndex": 0 },
        { "de": "Was antwortet Lena am Ende?", "options": ["Vielen Dank", "Kein Problem", "Auf Wiedersehen"], "answerIndex": 1 }
      ]
    }
  ]
